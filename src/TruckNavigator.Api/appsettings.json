{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "TruckNavigator": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=trucknavigator.db"
  },
  "GraphHopper": {
    "BaseUrl": "http://localhost:8989",
    "Profile": "truck",
    "TimeoutSeconds": 60
  },
  "Geocoding": {
    "BaseUrl": "https://photon.komoot.io",
    "BiasLatitude": -34.6083,
    "BiasLongitude": -58.437,
    "BiasScale": 0.4,
    "MaxResults": 8,
    "TimeoutSeconds": 15,
    "UserAgent": "TruckNavigator-CABA/0.1"
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "User": "",
    "Password": "",
    "FromAddress": "no-responder@trucknavigator.local",
    "FromName": "Navegador de Transito Pesado",
    "TimeoutSeconds": 20
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  }
}
