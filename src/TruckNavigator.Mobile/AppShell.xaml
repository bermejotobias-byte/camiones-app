<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Una sola pantalla. La navegacion entera —mapa, camiones, perfil, historial—
    la resuelve la aplicacion web adentro del WebView, asi que el Shell no tiene
    rutas que registrar ni pestañas que mostrar.
-->
<Shell
    x:Class="TruckNavigator.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TruckNavigator.Mobile.Pages"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Title="Navegador Camiones">

    <ShellContent
        ContentTemplate="{DataTemplate pages:AppPage}"
        Route="AppPage" />

</Shell>
