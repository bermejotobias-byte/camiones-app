<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- El MVP apunta solo a Android. Los TFM de iOS/MacCatalyst se agregan
		     cuando corresponda: la app no tiene codigo especifico de plataforma
		     mas alla del manifest, asi que sumarlos no requiere reescribirla. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>TruckNavigator.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!--
		    Que los mensajes de error del framework se puedan leer en el APK.

		    Al recortar, .NET reemplaza por defecto los textos de las excepciones
		    del framework por sus claves de recurso para ahorrar tamano. En Release
		    —el unico build que se instala en un telefono— eso convierte cualquier
		    error en algo como "net_http_client_invalid_requesturi", que no le
		    dice nada ni al usuario ni a quien lo esta diagnosticando a distancia.
		    Costo una noche entera. Ver AD-33.
		-->
		<UseSystemResourceKeys>false</UseSystemResourceKeys>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Navegador Camiones</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>ar.com.trucknavigator.caba</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<!-- Android 6.0. Lo exige el proveedor de ubicacion combinado de Google, que
		     declara minSdk 23: con 21 el merge del manifiesto falla el build. No es
		     una perdida real —Android 5 es de 2014— y ademas alinea el codigo con
		     las APIs que ya se usaban, como PendingIntentFlags.Immutable, que
		     tambien pide 23 y venia dando aviso. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- La interfaz es la MISMA aplicacion web que sirve la API. Se enlaza
		     desde alli en lugar de copiarla al repositorio: dos copias divergen,
		     y esta es justo la clase de cosa que se descubre tarde y en el
		     telefono.

		     LogicalName la deja bajo "wwwroot/", que es el HybridRoot que espera
		     el control. -->
		<MauiAsset Include="..\TruckNavigator.Api\wwwroot\**\*"
		           LogicalName="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!-- Proveedor de ubicacion combinado de Google.

	     El LocationManager del sistema entrega el GPS crudo: bajo techo tarda
	     decenas de segundos en enganchar, y su respaldo por antenas —el
	     NetworkProvider— puede estar deshabilitado en el telefono sin que la app
	     se entere. Medido en el equipo de prueba: dos pedidos consecutivos
	     expiraron a los 15 segundos con cero posiciones, con el NetworkProvider
	     apagado y el proveedor combinado disponible y sin usar.

	     El combinado mezcla satelites, WiFi, antenas y sensores, y da la primera
	     posicion en uno o dos segundos tambien adentro de un edificio. El
	     LocationManager queda como respaldo para telefonos sin Play Services. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.GooglePlayServices.Location" Version="121.3.0.9" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\TruckNavigator.Domain\TruckNavigator.Domain.csproj" />
	</ItemGroup>

</Project>
