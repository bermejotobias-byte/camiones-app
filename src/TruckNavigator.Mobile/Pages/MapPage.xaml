<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TruckNavigator.Mobile.Pages.MapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:TruckNavigator.Mobile.Services"
    Title="Navegación">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Cabecera: camión y búsqueda de origen/destino -->
        <VerticalStackLayout Grid.Row="0" Padding="12,8" Spacing="6"
                             BackgroundColor="{AppThemeBinding Light=#f1f3f4, Dark=#202124}">

            <Label x:Name="TruckLabel" FontSize="13" FontAttributes="Bold" />

            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="6">
                <BoxView Grid.Column="0" WidthRequest="12" HeightRequest="12" CornerRadius="6"
                         Color="#1b7f3b" VerticalOptions="Center" HorizontalOptions="Center" />
                <Entry Grid.Column="1" x:Name="OriginEntry" Placeholder="Origen"
                       FontSize="14" ReturnType="Search"
                       TextChanged="OnOriginTextChanged" Focused="OnOriginFocused" />
                <Button Grid.Column="2" Text="GPS" FontSize="11" Padding="10,4"
                        Clicked="OnLocateMe" VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="6">
                <BoxView Grid.Column="0" WidthRequest="12" HeightRequest="12" CornerRadius="6"
                         Color="#b3261e" VerticalOptions="Center" HorizontalOptions="Center" />
                <Entry Grid.Column="1" x:Name="DestinationEntry" Placeholder="Destino"
                       FontSize="14" ReturnType="Search"
                       TextChanged="OnDestinationTextChanged" Focused="OnDestinationFocused" />
                <Button Grid.Column="2" Text="Mapa" FontSize="11" Padding="10,4"
                        Clicked="OnPickOnMap" VerticalOptions="Center" />
            </Grid>

            <Label x:Name="HintLabel" FontSize="11"
                   TextColor="{AppThemeBinding Light=#5f6368, Dark=#c4c7c5}" />

            <!-- Diagnóstico: muestra si cada punto quedó realmente fijado.
                 Un campo con texto no alcanza; hace falta la coordenada. -->
            <Label x:Name="DebugLabel" FontSize="10" FontFamily="Monospace"
                   TextColor="{AppThemeBinding Light=#7a5900, Dark=#e0b040}" />
        </VerticalStackLayout>

        <!-- Mapa con la lista de sugerencias por encima -->
        <Grid Grid.Row="1">
            <HybridWebView x:Name="MapView"
                           HybridRoot="wwwroot"
                           DefaultFile="index.html"
                           RawMessageReceived="OnMapMessageReceived" />

            <Border x:Name="SuggestionsPanel" IsVisible="False"
                    VerticalOptions="Start" Margin="8,6"
                    Padding="0" StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#dadce0, Dark=#3c4043}"
                    BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#202124}"
                    StrokeShape="RoundRectangle 10"
                    MaximumHeightRequest="300">

                <CollectionView x:Name="SuggestionsView" SelectionMode="Single"
                                SelectionChanged="OnSuggestionSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:PlaceDto">
                            <Grid Padding="12,10" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="📍" FontSize="14" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="{Binding Label}" FontSize="14" />
                                    <Label Text="{Binding Secondary}" FontSize="11"
                                           TextColor="{AppThemeBinding Light=#5f6368, Dark=#c4c7c5}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- Botón flotante que abre los filtros de puntos de interés -->
            <Button x:Name="PoiToggleButton" Text="Lugares" FontSize="12"
                    Padding="12,6" CornerRadius="18"
                    VerticalOptions="End" HorizontalOptions="End" Margin="10"
                    Clicked="OnTogglePoiFilters" />

            <!-- Filtros por categoría -->
            <Border x:Name="PoiFilterPanel" IsVisible="False"
                    VerticalOptions="End" HorizontalOptions="End" Margin="10,10,10,54"
                    Padding="12,10" StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#dadce0, Dark=#3c4043}"
                    BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#202124}"
                    StrokeShape="RoundRectangle 10">

                <VerticalStackLayout Spacing="2" WidthRequest="260">
                    <Label Text="Puntos de interés" FontSize="13" FontAttributes="Bold"
                           Margin="0,0,0,4" />

                    <!-- Las filas se arman en código a partir de PoiPresentation.All,
                         para que sumar una categoría no obligue a tocar el XAML. -->
                    <VerticalStackLayout x:Name="PoiFilterRows" Spacing="0" />

                    <BoxView HeightRequest="1" Margin="0,6"
                             Color="{AppThemeBinding Light=#e8eaed, Dark=#3c4043}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" x:Name="SuitableOnlyLabel"
                               Text="Solo aptos para mi camión"
                               FontSize="13" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="SuitableOnlySwitch"
                                Toggled="OnSuitableOnlyToggled" />
                    </Grid>

                    <Label x:Name="PoiHiddenLabel" FontSize="11" Margin="0,4,0,0"
                           TextColor="{AppThemeBinding Light=#5f6368, Dark=#c4c7c5}" />
                </VerticalStackLayout>
            </Border>

            <!-- Ficha del punto tocado en el mapa -->
            <Border x:Name="PoiCardPanel" IsVisible="False"
                    VerticalOptions="End" Margin="8"
                    Padding="14,12" StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#dadce0, Dark=#3c4043}"
                    BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#202124}"
                    StrokeShape="RoundRectangle 12"
                    MaximumHeightRequest="330">

                <ScrollView>
                    <VerticalStackLayout Spacing="5">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" x:Name="PoiNameLabel" FontSize="16"
                                   FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="✕" FontSize="16"
                                   TextColor="{AppThemeBinding Light=#5f6368, Dark=#c4c7c5}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnClosePoiCard" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <Label x:Name="PoiCategoryLabel" FontSize="12"
                               TextColor="{AppThemeBinding Light=#5f6368, Dark=#c4c7c5}" />

                        <Label x:Name="PoiAddressLabel" FontSize="13" />
                        <Label x:Name="PoiHoursLabel" FontSize="13" />
                        <Label x:Name="PoiPhoneLabel" FontSize="13" />
                        <Label x:Name="PoiDescriptionLabel" FontSize="12" />
                        <Label x:Name="PoiServicesLabel" FontSize="12" />

                        <!-- Aptitud: se muestra tal cual está, incluso cuando no consta -->
                        <Border x:Name="PoiSuitabilityBox" Margin="0,4,0,0" Padding="9,7"
                                StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                BackgroundColor="{AppThemeBinding Light=#fef7e0, Dark=#332d1a}">
                            <VerticalStackLayout Spacing="2">
                                <Label x:Name="PoiSuitabilityLabel" FontSize="12"
                                       FontAttributes="Bold" />
                                <Label x:Name="PoiVerificationLabel" FontSize="11" />
                            </VerticalStackLayout>
                        </Border>

                        <Label x:Name="PoiSourceLabel" FontSize="10" Margin="0,4,0,0"
                               TextColor="{AppThemeBinding Light=#5f6368, Dark=#c4c7c5}" />

                        <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                            <Button x:Name="PoiDestinationButton" Text="Usar como destino"
                                    FontSize="12" Padding="12,6" Clicked="OnUsePoiAsDestination" />
                            <Button x:Name="PoiCallButton" Text="Llamar" FontSize="12"
                                    Padding="12,6" Clicked="OnCallPoi" />
                            <Button x:Name="PoiWebButton" Text="Web" FontSize="12"
                                    Padding="12,6" Clicked="OnOpenPoiWebsite" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- Resultado -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,Auto" Padding="12,10" RowSpacing="8"
              BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#202124}">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label x:Name="SummaryLabel" FontSize="15" FontAttributes="Bold"
                           Text="Sin ruta calculada" />
                    <Label x:Name="NetworkLabel" FontSize="12"
                           TextColor="{AppThemeBinding Light=#5f6368, Dark=#c4c7c5}" />
                </VerticalStackLayout>

                <Button Grid.Column="1" x:Name="RouteButton" Text="Calcular ruta"
                        FontSize="13" Padding="14,8" Clicked="OnCalculateRoute" />
            </Grid>

            <!-- Leyenda de los colores del trazado -->
            <HorizontalStackLayout Grid.Row="1" x:Name="LegendPanel" Spacing="14"
                                   IsVisible="False">
                <HorizontalStackLayout Spacing="5">
                    <BoxView WidthRequest="18" HeightRequest="4" CornerRadius="2"
                             Color="#1a56db" VerticalOptions="Center" />
                    <Label Text="Red de Tránsito Pesado" FontSize="11"
                           TextColor="{AppThemeBinding Light=#5f6368, Dark=#c4c7c5}" />
                </HorizontalStackLayout>

                <HorizontalStackLayout x:Name="AccessLegend" Spacing="5">
                    <BoxView WidthRequest="18" HeightRequest="4" CornerRadius="2"
                             Color="#e07a00" VerticalOptions="Center" />
                    <Label Text="Acceso a origen/destino" FontSize="11"
                           TextColor="{AppThemeBinding Light=#5f6368, Dark=#c4c7c5}" />
                </HorizontalStackLayout>

                <Label Text="ⓘ" FontSize="15" TextColor="#1a56db" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLegendInfo" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <Label Grid.Row="2" x:Name="ErrorLabel" TextColor="#b3261e" FontSize="13"
                   IsVisible="False" />

            <!-- Panel de "por qué": cada restricción con su fuente -->
            <CollectionView Grid.Row="3" x:Name="NotesView" MaximumHeightRequest="150"
                            IsVisible="False" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:RestrictionNoteView">
                        <Border Margin="0,0,0,6" Padding="10" StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#fef7e0, Dark=#332d1a}"
                                StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" />
                                <Label Text="{Binding Description}" FontSize="12" />
                                <Label Text="{Binding Source}" FontSize="10"
                                       TextColor="{AppThemeBinding Light=#5f6368, Dark=#c4c7c5}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
