<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TruckNavigator.Mobile.Pages.TruckEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Nuevo camión">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="Todas las medidas en unidades métricas." FontSize="12"
                   TextColor="{AppThemeBinding Light=#5f6368, Dark=#c4c7c5}" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Nombre" FontSize="13" />
                <Entry x:Name="NameEntry" Placeholder="Camión Mercedes" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Peso total bruto (kg)" FontSize="13" />
                <Entry x:Name="WeightEntry" Keyboard="Numeric" Placeholder="18000" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Altura (m)" FontSize="13" />
                <Entry x:Name="HeightEntry" Keyboard="Numeric" Placeholder="3.80" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Ancho (m)" FontSize="13" />
                <Entry x:Name="WidthEntry" Keyboard="Numeric" Placeholder="2.50" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Longitud del vehículo (m)" FontSize="13" />
                <Entry x:Name="LengthEntry" Keyboard="Numeric" Placeholder="12.00" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Cantidad de ejes" FontSize="13" />
                <Entry x:Name="AxlesEntry" Keyboard="Numeric" Placeholder="3" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Tipo de vehículo" FontSize="13" />
                <Picker x:Name="VehicleTypePicker">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Camión simple</x:String>
                            <x:String>Camión con acoplado</x:String>
                            <x:String>Semirremolque</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Switch x:Name="TrailerSwitch" Toggled="OnTrailerToggled" />
                <Label Text="Tiene acoplado" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <VerticalStackLayout x:Name="TrailerPanel" Spacing="4" IsVisible="False">
                <Label Text="Longitud del acoplado (m)" FontSize="13" />
                <Entry x:Name="TrailerLengthEntry" Keyboard="Numeric" Placeholder="12.00" />
                <Label
                    Text="La longitud total del conjunto es la que se compara contra los límites de cada calle."
                    FontSize="11"
                    TextColor="{AppThemeBinding Light=#5f6368, Dark=#c4c7c5}" />
            </VerticalStackLayout>

            <Label x:Name="ErrorLabel" TextColor="#b3261e" FontSize="13" IsVisible="False" />

            <Button x:Name="SaveButton" Text="Guardar" Clicked="OnSave" Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
