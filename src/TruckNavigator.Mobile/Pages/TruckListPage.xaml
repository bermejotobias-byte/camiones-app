<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TruckNavigator.Mobile.Pages.TruckListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:TruckNavigator.Mobile.Services"
    Title="Seleccionar camión">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Label
                Text="Elegí el vehículo con el que vas a circular. Sus dimensiones determinan por dónde puede pasar la ruta."
                FontSize="13"
                TextColor="{AppThemeBinding Light=#5f6368, Dark=#c4c7c5}" />
            <Label
                x:Name="StatusLabel"
                FontSize="12"
                TextColor="#b3261e"
                IsVisible="False" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" x:Name="Refresher" Refreshing="OnRefreshing">
            <CollectionView x:Name="TrucksView" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label
                        Text="No hay camiones cargados todavía."
                        HorizontalTextAlignment="Center"
                        Margin="0,40,0,0" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:TruckProfileDto">
                        <Border
                            Margin="0,0,0,10"
                            Padding="14"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#dadce0, Dark=#3c4043}"
                            StrokeShape="RoundRectangle 12">

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" />
                                    <Label
                                        Text="{Binding DimensionsSummary}"
                                        FontSize="13"
                                        TextColor="{AppThemeBinding Light=#5f6368, Dark=#c4c7c5}" />
                                    <Label
                                        Text="Datos de prueba"
                                        FontSize="11"
                                        TextColor="#e07a00"
                                        IsVisible="{Binding IsSampleData}" />
                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="1"
                                    Text="Seleccionar"
                                    FontSize="13"
                                    Padding="14,8"
                                    VerticalOptions="Center"
                                    Clicked="OnTruckSelected"
                                    CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Button Text="Nuevo camión" Clicked="OnNewTruck" />
            <Button
                Text="Configurar servidor"
                Clicked="OnConfigureServer"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light=#1a56db, Dark=#8ab4f8}"
                FontSize="13" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
