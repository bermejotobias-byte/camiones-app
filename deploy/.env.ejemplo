# Copiar a deploy/.env y completar. Este archivo SI se versiona; .env NO.
#
#   cp .env.ejemplo .env
#
# El repositorio es publico: la contrasena de SMTP no puede terminar aca.

# Dominio con el que Caddy pide el certificado a Let's Encrypt.
DOMAIN=micamion.duckdns.org

# El backend NO arranca en Production sin esto, y es deliberado: sin envio de
# mail los enlaces de verificacion terminan en el log del servidor, y cualquiera
# que lo lea podria activar cuentas ajenas.
#
# El enlace se arma con el host desde el que llega el pedido, asi que detras del
# proxy tiene que llegar el Host original — el Caddyfile ya reenvia las cabeceras
# necesarias. Si el mail llega con un enlace a localhost, el problema esta ahi.
Email__Host=smtp.tuproveedor.com
Email__Port=587
Email__UseStartTls=true
Email__User=no-responder@tudominio.com
Email__Password=
Email__FromAddress=no-responder@tudominio.com
Email__FromName=Navegador de Transito Pesado
